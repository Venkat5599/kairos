{
  "name": "@kairos/solver-bot",
  "version": "1.0.0",
  "description": "IntentFlow solver bot for executing intents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "start:simple": "ts-node src/index-simple.ts",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index-simple.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ethers": "^6.10.0",
    "@polkadot/api": "^10.11.2",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2"
  }
}
