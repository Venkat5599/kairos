# Kairos - Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# Deployed Contract Addresses
# Get these after running: cd packages/contracts && bash deploy-moonbase.sh
NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS=0x...
NEXT_PUBLIC_INTENT_ROUTER_ADDRESS=0x...
NEXT_PUBLIC_XCM_BRIDGE_ADDRESS=0x...

# Network Configuration (Moonbase Alpha Testnet)
NEXT_PUBLIC_RPC_URL=https://rpc.api.moonbase.moonbeam.network
NEXT_PUBLIC_CHAIN_ID=1287
NEXT_PUBLIC_NETWORK_NAME=Moonbase Alpha

# Block Explorer
NEXT_PUBLIC_EXPLORER_URL=https://moonbase.moonscan.io
