# Network Configuration
POLKADOT_HUB_RPC_URL=https://polkadot-hub-rpc.example.com
CHAIN_ID=1000

# Private Keys (NEVER commit actual keys)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
SOLVER_PRIVATE_KEY=your_solver_private_key_here

# Contract Addresses (fill after deployment)
INTENT_REGISTRY_ADDRESS=
INTENT_ROUTER_ADDRESS=
XCM_BRIDGE_ADDRESS=

# Database
DATABASE_URL=postgresql://kairos:password@localhost:5432/kairos
POSTGRES_USER=kairos
POSTGRES_PASSWORD=password
POSTGRES_DB=kairos

# Backend API
BACKEND_PORT=3001
BACKEND_HOST=localhost
JWT_SECRET=your_jwt_secret_here
API_KEY=your_api_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=1000
NEXT_PUBLIC_RPC_URL=https://polkadot-hub-rpc.example.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here
NEXT_PUBLIC_INTENT_REGISTRY_ADDRESS=

# Solver Bot
SOLVER_POLL_INTERVAL=5000
SOLVER_GAS_LIMIT=500000
SOLVER_MIN_REWARD=0.01

# Indexer
SUBSQUID_ARCHIVE_URL=https://polkadot-hub.archive.subsquid.io
INDEXER_START_BLOCK=0

# Redis (for solver coordination)
REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_DSN=
LOG_LEVEL=debug
